<mujoco model="eraser">
  <!-- Box-only eraser (0.05 x 0.125 x 0.03 m, origin at bbox center). Same mass / inertia / collision box
       as the textured original used for training; the ~110 MB visual mesh and PBR textures are dropped.
       Converted to USD with IsaacLab's scripts/tools/convert_mjcf.py, then post-processed and flattened with
       regrind/scripts/tools/process_object_usd.py (see README). -->
  <compiler angle="radian" />
  <option timestep="0.002" integrator="implicitfast" cone="elliptic" impratio="100"/>

  <default>
    <geom solimp="0.99 0.999 0.01 0.001 1" solref="0.001 1" friction=".2"/>
    <joint damping="0.03" frictionloss="0.001"/>
    <default class="visual">
      <geom group="1" contype="0" conaffinity="0" density="0" material="eraser_color" />
    </default>
  </default>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4" rgb2="0.1 0.2 0.3"
      markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.2"/>

    <!-- Materials -->
    <material name="eraser_color" rgba="0.93 0.42 0.50 1.0"/>
    <material name="obj_color" rgba="1.0 0.423529411765 0.0392156862745 1.0"/>
    <material name="obj_bottom_color" rgba="0.4 0.8 1.0 1.0"/>
  </asset>

  <worldbody>

    <light name="top" pos="0 0 3" mode="fixed" castshadow="false" directional="false"/>
    <geom name="floor" pos="0 0 0" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Bottom link (base) -->
    <body name="bottom" pos="0 0 0" quat="1 0 0 0">
        <freejoint/>
        <inertial pos="0.0 0.0 0.0"
                  mass="0.0126"
                  diaginertia="1.718e-05 3.390e-06 1.882e-05"/>

        <geom name="bottom_visual" type="box" size="0.025 0.0625 0.015" class="visual"/>
        <geom name="bottom_collision" type="box" size="0.025 0.0625 0.015" material="obj_bottom_color"/>
    </body>
  </worldbody>

</mujoco>
